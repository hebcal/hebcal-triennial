{
  "name": "@hebcal/triennial",
  "version": "6.4.0",
  "description": "Javascript Triennial Torah Readings",
  "module": "./dist/esm/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/esm/index.js",
    "./dist/esm/*": "./dist/esm/*.js"
  },
  "typings": "dist/esm/index.d.ts",
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "build:data": "node scripts/gen-json-modules.mjs",
    "build": "npm run build:data && tsc",
    "prepublish": "npm run build",
    "predocs": "npm run build:data",
    "docs": "npx -y typedoc",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fix": "oxlint --fix && prettier --write \"src/**/*.ts\"",
    "lint": "oxlint && prettier --check \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebcal/hebcal-triennial.git"
  },
  "author": "Michael J. Radwin (https://github.com/mjradwin)",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/hebcal/hebcal-triennial/issues"
  },
  "homepage": "https://hebcal.github.io/api/triennial/",
  "dependencies": {
    "@hebcal/core": "^6.13.0",
    "@hebcal/hdate": "^0.23.0",
    "@hebcal/leyning": "^10.0.2",
    "quick-lru": "^7.3.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
